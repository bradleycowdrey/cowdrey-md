<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the Mac App Store build only (tauri.appstore.conf.json, .github/workflows/mac-app-store.yml).
  The direct-download DMG is not sandboxed and does not use this file.
-->
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Open and save the Markdown files the person picks (Open, Save As, exports, files opened from Finder)
	     and the sync folder they choose. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Security-scoped bookmarks (src/bookmarks.rs): recent files, saving back to a file and the sync folder
	     keep working after the app restarts. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Outgoing connections only: the daily Terms of Use check (raw.githubusercontent.com) and images
	     that documents link by URL. Nothing listens for incoming connections. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Print, and Export PDF through the print dialog. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Must match the Mac App Store provisioning profile (team 2XV97FZ86G, same bundle ID as the iPhone app). -->
	<key>com.apple.application-identifier</key>
	<string>2XV97FZ86G.com.bradcowdrey.cowdreymd</string>
	<key>com.apple.developer.team-identifier</key>
	<string>2XV97FZ86G</string>
</dict>
</plist>
