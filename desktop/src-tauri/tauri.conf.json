{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cowdrey.MD",
  "version": "1.0.23",
  "identifier": "com.bradcowdrey.cowdreymd",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cowdrey.MD",
        "width": 1360,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "publisher": "Bradley Cowdrey",
    "copyright": "© 2026 Bradley Cowdrey",
    "homepage": "https://bradcowdrey.com",
    "shortDescription": "Markdown editor",
    "longDescription": "Cowdrey.MD is a Markdown editor by Bradley Cowdrey that combines MacDown's split view, a Docs page and a Word ribbon.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "iOS": {
      "developmentTeam": "2XV97FZ86G",
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MEY1NkM0OEZBMUY4RkUKUldUKytLR1B4RllQV0pDTU91emFwY3J2UXk5dFF6Y1ZITXVzSmdlalFGbHhLbGIyeXVZR3BFL0EK",
      "endpoints": [
        "https://github.com/bradleycowdrey/cowdrey-md/releases/latest/download/latest.json"
      ]
    }
  }
}
